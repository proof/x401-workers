{
  "name": "@proof.com/x401-workers",
  "version": "0.2.0",
  "description": "x401 middleware for Cloudflare Workers.",
  "keywords": [
    "x401",
    "Cloudflare Workers",
    "Verifiable Presentation",
    "OID4VP",
    "Agent",
    "Verifier",
    "Proof",
    "Proof.com"
  ],
  "homepage": "https://github.com/proof/x401-workers",
  "bugs": "https://github.com/proof/x401-workers/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/proof/x401-workers.git"
  },
  "license": "Apache-2.0",
  "author": "Jeremie Charrier <jeremie.charrier@proof.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-all": "yarn format && yarn lint && yarn typecheck && yarn test && yarn publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepare": "npm run build",
    "publint": "publint --pack npm",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proof.com/proof-vc-common": "^0.7.0",
    "@proof.com/proof-vc-server": "^0.7.0",
    "@proof.com/x401-node": "^0.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^24.13.2",
    "eslint": "^10.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "hono": "^4.10.0",
    "jose": "^6.2.4",
    "prettier": "^3.8.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
